{
  "input": {
    "label": {
      "numberOfLines": 1,
      "color": "#0A1325",
      "fontSize": 12,
      "text-align": "left",
      "font-weight": "600",
      "fontFamily": "OpenSans-SemiBold"
    },
    "labelDisabled": {
      "color": "#0A1325"
