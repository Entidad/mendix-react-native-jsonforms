<?xml version="1.0" encoding="utf-8"?>
<widget xmlns="http://www.mendix.com/widget/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="io.entidad.widget.native.jsonforms.JsonForms" pluginWidget="true" needsEntityContext="true" offlineCapable="true" supportedPlatform="Native" xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
  <name>JsonForms Native</name>
  <description>Mendix JsonForms Render for Native</description>
  <icon></icon>
  <properties>
    <propertyGroup caption="General">
      <property key="mxSchema" type="attribute" required="true">
        <caption>JSON Schema</caption>
        <description>An attribute to fetch JSON Schema</description>
        <attributeTypes>
          <attributeType name="String"/>
        </attributeTypes>
      </property>
      <property key="mxUiSchema" type="attribute" required="true">
        <caption>UI Schema</caption>
        <description>General layout of a form in JSON object</description>
        <attributeTypes>
          <attributeType name="String"/>
        </attributeTypes>
      </property>
      <property key="mxInitData" type="attribute" required="true">
        <caption>initData</caption>
        <description>Default values containing the data to be rendered in the form</description>
        <attributeTypes>
          <attributeType name="String"/>
        </attributeTypes>
      </property>
      <property key="mxFormData" type="attribute" required="true" onChange="onChangeAction">
        <caption>formData</caption>
        <description>Containing the data after submit the form</description>
        <attributeTypes>
          <attributeType name="String"/>
        </attributeTypes>
      </property>
      <property key="mxI18nData" type="attribute" required="true">
        <caption>i18n</caption>
        <description>Includes all the translatable strings in other specified languages for the form</description>
        <attributeTypes>
          <attributeType name="String"/>
        </attributeTypes>
      </property>
      <property key="mxLanguage" type="attribute" required="true">
        <caption>Language</caption>
        <description>The code of default language in which to display the form</description>
        <attributeTypes>
          <attributeType name="String"/>
        </attributeTypes>
      </property>
      <property key="mxReadOnly" type="attribute" required="true">
        <caption>ReadOnly</caption>
        <description>Makes the controls of the form no editable, present only the values</description>
        <attributeTypes>
          <attributeType name="Boolean"/>
        </attributeTypes>
      </property>
    </propertyGroup>
    <propertyGroup caption="Events">
      <property key="onChangeAction" type="action" required="false">
        <caption>On change action</caption>
        <description>Action to trigger when submit the JSON Form</description>
      </property>
    </propertyGroup>
    <propertyGroup caption="UI">
      <property key="mxStyleData" type="expression" defaultValue="'{}'">
        <caption>Style JSON</caption>
        <description/>
        <returnType type="String"/>
      </property>
    </propertyGroup>
  </properties>
</widget>
